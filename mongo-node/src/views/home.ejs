<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Orbit - Home</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <style>
    body { background: #f3f1fb; }
    .hero {
      background: linear-gradient(135deg, #6a3de8 0%, #9c6bff 100%);
      color: #fff;
      padding: 80px 20px 100px;
      text-align: center;
    }
    .hero h1 { font-weight: 600; }
    .feature-card {
      margin-top: -60px;
    }
    .feature-icon {
      font-size: 40px;
      color: #6a3de8;
    }
  </style>
</head>
<body>

  <nav class="transparent z-depth-0">
    <div class="nav-wrapper container">
      <a href="/" class="brand-logo" style="color:#fff;"><i class="material-icons left">hub</i>Orbit</a>
    </div>
  </nav>

  <div class="hero">
    <h1>Orbit Social</h1>
    <p class="flow-text">Un lugar para publicar, conectar y descubrir lo que hace tu comunidad</p>
    <a href="/posts/" class="btn-large waves-effect waves-light white black-text" style="margin-top: 20px;">
      Explorar publicaciones <i class="material-icons right">arrow_forward</i>
    </a>
  </div>

  <div class="container feature-card">
    <div class="row">
      <div class="col s12 m4">
        <div class="card center-align" style="padding: 20px;">
          <i class="material-icons feature-icon">edit_note</i>
          <h6>Publica</h6>
          <p class="grey-text">Comparte lo que piensas con tu propio texto e imágenes.</p>
        </div>
      </div>
      <div class="col s12 m4">
        <div class="card center-align" style="padding: 20px;">
          <i class="material-icons feature-icon">tag</i>
          <h6>Etiqueta</h6>
          <p class="grey-text">Organiza tus posts con hashtags para que sean fáciles de encontrar.</p>
        </div>
      </div>
      <div class="col s12 m4">
        <div class="card center-align" style="padding: 20px;">
          <i class="material-icons feature-icon">groups</i>
          <h6>Conecta</h6>
          <p class="grey-text">Descubre publicaciones de toda la comunidad en un solo lugar.</p>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>
