<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Orbit - Publicaciones</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <style>
    body { background: #f3f1fb; padding-bottom: 80px; }
    .post-card { border-radius: 10px; overflow: hidden; }
    .post-banner {
      height: 90px;
      background: linear-gradient(135deg, #6a3de8 0%, #9c6bff 100%);
      position: relative;
    }
    .avatar-circle {
      width: 56px; height: 56px; border-radius: 50%;
      background: #fff; color: #6a3de8;
      display: flex; align-items: center; justify-content: center;
      font-weight: 600; font-size: 20px;
      position: absolute; bottom: -28px; left: 20px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.2);
    }
    .post-content { padding-top: 40px; flex-grow: 1; display: flex; flex-direction: column; }
    .fixed-action-btn { position: fixed; bottom: 30px; right: 30px; }
    .posts-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 20px;
      margin-top: 20px;
    }
    .posts-grid .post-card { width: 100%; height: 100%; display: flex; flex-direction: column; margin: 0; }
  </style>
</head>
<body>

  <nav class="purple darken-3">
    <div class="nav-wrapper container">
      <a href="/" class="brand-logo"><i class="material-icons left">hub</i>Orbit</a>
    </div>
  </nav>

  <div class="container" style="margin-top: 30px;">
    <h4 class="center-align purple-text text-darken-3">Publicaciones de la comunidad</h4>

    <% if (posts.length === 0) { %>
      <p class="center-align grey-text">Todavía no hay publicaciones. Sé el primero en compartir algo.</p>
    <% } %>

    <div class="posts-grid">
      <% posts.forEach(function(post) { %>
        <% var initials = post.user ? (post.user.name[0] + (post.user.lastName ? post.user.lastName[0] : '')) : '?'; %>
        <div class="card post-card">
          <div class="post-banner">
            <div class="avatar-circle"><%= initials.toUpperCase() %></div>
          </div>
          <div class="card-content post-content">
            <span class="card-title" style="font-weight:600;"><%= post.title %></span>
            <p class="grey-text text-darken-1"><%= post.content %></p>

            <% if (post.imageUrl) { %>
              <img src="<%= post.imageUrl %>" style="width:100%; border-radius:6px; margin-top:10px;" alt="imagen del post">
            <% } %>

            <% if (post.hashtags && post.hashtags.length > 0) { %>
              <div style="margin-top: 10px;">
                <% post.hashtags.forEach(function(tag) { %>
                  <span class="chip purple lighten-4 purple-text text-darken-3">#<%= tag %></span>
                <% }) %>
              </div>
            <% } %>

            <p class="grey-text" style="margin-top: 10px; font-size: 0.85em;">
              por <strong><%= post.user ? (post.user.name + ' ' + post.user.lastName) : 'Desconocido' %></strong>
            </p>
          </div>
          <div class="card-action" style="display:flex; justify-content:flex-end; gap: 5px;">
            <a href="/posts/<%= post._id %>/edit" class="btn-flat waves-effect">
              <i class="material-icons purple-text text-darken-2">edit</i>
            </a>
            <form action="/posts/<%= post._id %>/delete" method="POST" onsubmit="return confirm('¿Eliminar este post?');">
              <button type="submit" class="btn-flat waves-effect" style="background:none;border:none;">
                <i class="material-icons red-text">delete_outline</i>
              </button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <div class="fixed-action-btn">
    <a href="/posts/new" class="btn-floating btn-large purple darken-3 waves-effect waves-light">
      <i class="material-icons">add</i>
    </a>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>
